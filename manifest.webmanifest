{
  "name": "Dopamine Calendar",
  "short_name": "Dopamine",
  "description": "A colorful face for Google Calendar and Google Tasks",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#FFE6E2",
  "theme_color": "#FF8FA4",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Migraine now",
      "short_name": "Migraine",
      "description": "Open straight into the dark migraine mode",
      "url": "./?migraine",
      "icons": [
        {
          "src": "icon-migraine-96.png",
          "sizes": "96x96",
          "type": "image/png"
        },
        {
          "src": "icon-migraine-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "New event",
      "short_name": "New event",
      "url": "./?new",
      "icons": [
        {
          "src": "icon-new-96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
  ]
}
